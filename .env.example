# ─────────────────────────────────────────────────────────────────────────────
# AeroGuard – environment variables template
# Copy this file to .env and fill in the values before running Docker Compose.
#
#   cp .env.example .env
#
# The .env file is loaded automatically by Docker Compose for variable
# substitution (${VAR:-default} syntax).  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ── PostgreSQL / PostGIS ──────────────────────────────────────────────────────
# These values must match across the postgres and api service definitions.
POSTGRES_USER=aeroguard
POSTGRES_PASSWORD=aeroguard
POSTGRES_DB=aeroguard
# POSTGRES_HOST and POSTGRES_PORT are set to Docker service names in compose;
# override here only for local (non-Docker) development.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
# REDIS_HOST and REDIS_PORT are set to Docker service names in compose.
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ── MQTT (Mosquitto) ──────────────────────────────────────────────────────────
# MQTT_BROKER_HOST and MQTT_BROKER_PORT are set to Docker service names in compose.
# MQTT_BROKER_HOST=localhost
# MQTT_BROKER_PORT=1883

# ── Google Directions API ────────────────────────────────────────────────────
# Leave blank to use fallback (two hard-coded candidate routes).
# Obtain a key at: https://console.cloud.google.com/apis/library/directions-backend.googleapis.com
GOOGLE_DIRECTIONS_API_KEY=

# ── Sensor simulator ──────────────────────────────────────────────────────────
# BACKEND_BASE_URL is set to http://api:8000 inside Docker; override for local runs.
# BACKEND_BASE_URL=http://localhost:8000
SIMULATOR_INTERVAL=30
SIMULATOR_SENSOR_COUNT=25
