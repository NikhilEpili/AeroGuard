# AeroGuard environment template
APP_ENV=development
DEBUG=true

POSTGRES_USER=aeroguard
POSTGRES_PASSWORD=aeroguard
POSTGRES_DB=aeroguard
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883

# Optional external provider (used only as additive enrichment)
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org

# Primary local OSRM provider (docker-compose osrm service)
OSRM_BASE_URL=http://osrm:5000

# Weighted route scoring: pollution-first objective
ROUTE_WEIGHT_POLLUTION=0.7
ROUTE_WEIGHT_DURATION=0.2
ROUTE_WEIGHT_DISTANCE=0.1

# Pollution data provider
OPENAQ_BASE_URL=https://api.openaq.org/v3
OPENAQ_RADIUS_M=12000
OPENAQ_LOCATION_LIMIT=100

# Background pollution-grid updater (stored in Redis)
CITY_MIN_LAT=18.88
CITY_MIN_LON=72.73
CITY_MAX_LAT=19.30
CITY_MAX_LON=73.05
POLLUTION_GRID_REFRESH_SECONDS=300
POLLUTION_GRID_CELL_SIZE_M=100

# Simulator
BACKEND_BASE_URL=http://api:8000
SIMULATOR_INTERVAL=30
SIMULATOR_SENSOR_COUNT=25
