VITE_API_BASE_URL=http://localhost:8000

# Optional custom light style URL for MapLibre GL JS.
# Leave this empty to use the production-safe built-in Carto Voyager raster style.
# If you want to try a vector style, you can set one here, but AeroGuard will
# automatically fall back to raster if the style is invalid at runtime.
VITE_MAP_STYLE_LIGHT_URL=
# Dark mode uses a built-in Carto Dark raster style object.
